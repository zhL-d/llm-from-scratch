# ===============================
# Project .env (local + optional Azure)
# ===============================

# ---- Core training config ----
# Require
# Default: cs336_basics/training_data.txt; set by config_azure_trial.yaml
# Format: /data/your_training_data
# Note: local: mounted by compose; azure: mounted by fileshare
TRAINDATA_PATH=/data/corpus.en
# Require
# Default: 263; set by config_azure_trial.yaml
# Note: need match to TRAINDATA_PATH
VOCAB_SIZE=500
# Default: cs336_basics/outputs; set by start_zhl.sh
LOG_DIR=
# Default: (auto = CPU count). set by code:
PRETOKEN_PROCS=

# ---- Runtime context ----
# Require
# LOCAL or AZURE (affects uploads/notifications in start_zhl.sh). Default: LOCAL. set by start_zhl.sh:
RUN_CONTEXT=LOCAL
# Python module to run. 
# Default: cs336_basics.train_bpe. set by start_zhl.sh:
MODULE=
# Require
# Used only for run metadata labeling. Default: unknown. set by start_zhl.sh:
IMAGE_TAG=dev-local

# ---- Local-only uploads (optional) ----
# Require if RUN_CONTEXT=LOCAL
# If set, logs will be uploaded to this SAS URL after run completes.
# Default: empty (disabled). Example: https://<account>.blob.core.windows.net/<container>/<path>?<sas>
OUTPUT_SAS_URL=https://<account>.blob.core.windows.net/<container>/<path>?<sas>

# ---- Notifications (optional) ----
# Require if RUN_CONTEXT=LOCAL
# Set to an ntfy.sh topic to receive simple push notifications.
# Default: empty (disabled). Example: my-bpe-job
NTFY_TOPIC=bpe-zhl

# ---- Azure uploads (used when RUN_CONTEXT=AZURE) ----
# Require if RUN_CONTEXT=AZURE
# Storage account name for Managed Identity uploads via azcopy.
# Default: empty. Current:
STORAGE_ACCOUNT=your_storage_account
# Require if RUN_CONTEXT=AZURE
# Target container for artifacts/logs. 
# Default: bpe-artifacts. set by start_zhl.sh:
ARTIFACTS_CONTAINER=bpe-artifacts
# Require if RUN_CONTEXT=AZURE
# Optional webhook (Logic App / Action Group) for status notifications. Default: empty. Current:
AZURE_MONITOR_WEBHOOK=your_web_hook

